# Server configuration for the Face Detection Visitor Analytics backend.
# Copy this file to ".env" and adjust as needed. All values are optional —
# the server runs fully in-memory when MONGODB_URI is not provided.

# HTTP / WebSocket port
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CLIENT_ORIGIN=http://localhost:5173

# OPTIONAL: MongoDB connection string (e.g. MongoDB Atlas).
# Leave blank/unset to run with the built-in in-memory store.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/face_analytics

# --- Face recognition / de-duplication (all optional) ---
# distance <= MATCH_THRESHOLD => confident same-person match
MATCH_THRESHOLD=0.55
# distance >= NEW_IDENTITY_THRESHOLD => may become a new identity (after confirmation)
NEW_IDENTITY_THRESHOLD=0.62
# how close an unmatched frame must be to merge into a pending candidate
CANDIDATE_MERGE_DISTANCE=0.55
# a new face must be confirmed across this many frames before it is counted
CONFIRM_FRAMES=2
# drop a pending candidate not seen for this long (kills single-frame glitches)
CANDIDATE_TTL_SECONDS=8
# EMA blend floor so a long-lived identity still tracks slow pose/lighting drift
EMA_ALPHA_FLOOR=0.05

# --- Sessions / presence ---
# the SAME person seen again after this gap counts as a new "return" visit
SESSION_GAP_SECONDS=120
# "present now" = identities seen within this window (keep > emit interval)
PRESENCE_WINDOW_SECONDS=10

# --- Rolling heatmap / footfall ---
# in-memory visit-log retention (the rolling 24h heatmap reads from this)
VISIT_LOG_RETENTION_HOURS=48

# --- Multi-face / broadcast ---
# max simultaneous faces processed per frame
MAX_FACES=8
# how often the snapshot is broadcast to dashboards (ms)
SNAPSHOT_INTERVAL_MS=2000
